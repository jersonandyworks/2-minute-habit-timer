{
	"name": "two-minute-habit-timer",
	"version": "2.0.0",
	"description": "2 minute habit counter",
	"main": "main.js",
	"scripts": {
		"start": "electron .",
		"pack": "electron-builder --dir",
		"dist": "electron-builder"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"electron": "^44.2.0",
		"electron-builder": "^26.15.3"
	},
	"build": {
		"appId": "com.example.timerapp",
		"productName": "TimerApp",
		"files": [
			"**/*"
		],
		"win": {
			"target": "nsis",
			"icon": "build/icon.ico"
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true
		}
	}
}
